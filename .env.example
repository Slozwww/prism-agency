# Variables d'environnement pour Netlify
# À configurer dans : Site Settings → Environment Variables

# Email Gmail (utilise un "Mot de passe d'application" Gmail, pas ton vrai mot de passe)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=ton-email@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=ton-email@gmail.com
EMAIL_TO=ton-email@gmail.com
